---
// In-gym workout screen: an attempt board docked at the thumb, exercise cards with last session's
// numbers, a rest clock, live PR verdicts and a session summary. Logic: src/scripts/workout.ts.
import exercises from '../../data/exercises.json';
import { days, exerciseName, plan, setsFor, type DayId } from '../lib/plan';
import { exerciseMemory } from '../lib/progress';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang].workout;
const dayIds = Object.keys(days) as DayId[];
const phaseInfo = plan.phases.map((p) => ({ id: p.id, weeks: p.weeks, label: p.label[lang], note: p.note[lang], rir: p.rir }));
const build = plan.phases.find((p) => p.id === 'build')!;
const exMap = exercises as unknown as Record<string, { equipment: string }>;
const exInfo = Object.fromEntries(
  dayIds.map((d) => [
    d,
    days[d].map((ex) => ({
      id: ex.id,
      name: exerciseName(ex.id, lang),
      equipment: exMap[ex.id].equipment,
      type: ex.type,
      reps: ex.reps,
      rest: ex.rest,
      sets: Object.fromEntries(plan.phases.map((p) => [p.id, setsFor(ex, p)])),
    })),
  ]),
);
const memory = exerciseMemory();
const dayLabel = (d: DayId) => (lang === 'ja' ? `${d}日` : `Day ${d}`);
---
<section
  class="workout"
  data-workout
  data-lang={lang}
  data-start={plan.start}
  data-weeks={plan.weeks}
  data-phases={JSON.stringify(phaseInfo)}
  data-exercises={JSON.stringify(exInfo)}
  data-memory={JSON.stringify(memory)}
>
  <div class="wk-controls">
    <div class="wk-weeks" role="group" aria-label={s.week}>
      {Array.from({ length: plan.weeks }, (_, i) => {
        const w = i + 1;
        const phase = plan.phases.find((p) => p.weeks.includes(w))!;
        return <button type="button" class="wk-week" data-week={w} data-phase={phase.id} aria-pressed="false">{w}</button>;
      })}
    </div>
    <p class="wk-phase"><strong data-phase-label>{build.label[lang]}</strong> <span data-phase-note>{build.note[lang]}</span></p>
    <div class="wk-days" role="group" aria-label={s.day}>
      {dayIds.map((d, i) => <button type="button" class="wk-day" data-day={d} aria-pressed={i === 0 ? 'true' : 'false'}>{dayLabel(d)}</button>)}
    </div>
  </div>

  <div class="wk-progress" aria-live="polite">
    <svg class="wk-bar" viewBox="0 0 320 64" aria-hidden="true">
      <rect class="bar-steel" x="4" y="29" width="312" height="6" rx="2" />
      <rect class="bar-collar" x="92" y="22" width="8" height="20" rx="1" />
      <rect class="bar-collar" x="220" y="22" width="8" height="20" rx="1" />
      <g data-plates-left></g>
      <g data-plates-right></g>
    </svg>
    <span class="wk-count" data-count></span>
  </div>

  <ol class="wk-list" data-list></ol>

  <div class="wk-actions">
    <button type="button" class="wk-btn wk-btn-primary" data-log-it>{s.logIt}</button>
    <button type="button" class="wk-btn" data-copy>{s.copy}</button>
    <label class="wk-toggle"><input type="checkbox" data-wake /> <span>{s.wake}</span></label>
    <button type="button" class="wk-btn wk-btn-quiet" data-reset>{s.reset}</button>
  </div>
  <p class="wk-hint" data-log-hint>{s.logHint}</p>

  <div class="board" data-board hidden>
    <p class="board-name" data-b-name></p>
    <p class="board-meta"><span data-b-set></span><span data-b-prev></span></p>
    <div class="board-load">
      <div class="stepper">
        <button type="button" data-kg-minus aria-label="kg −">−</button>
        <button type="button" class="board-big" data-b-kg aria-label={s.enterKg}></button>
        <button type="button" data-kg-plus aria-label="kg +">+</button>
        <span class="stepper-unit">kg</span>
      </div>
      <span class="board-x" aria-hidden="true">×</span>
      <div class="stepper">
        <button type="button" data-reps-minus aria-label={`${s.reps} −`}>−</button>
        <span class="board-big" data-b-reps></span>
        <button type="button" data-reps-plus aria-label={`${s.reps} +`}>+</button>
        <span class="stepper-unit">{s.reps}</span>
      </div>
    </div>
    <div class="board-rir" role="group" aria-label="RIR">
      <span>RIR</span>
      {[0, 1, 2, 3, 4].map((r) => <button type="button" data-rir={r} aria-pressed="false">{r}</button>)}
      <span class="board-target" data-b-target></span>
    </div>
    <p class="board-plates" data-b-plates hidden></p>
    <p class="board-warm" data-b-warm hidden></p>
    <button type="button" class="board-done" data-b-done>{s.doneBtn}</button>
  </div>

  <div class="clock" data-timer hidden>
    <p class="clock-label">{s.restTimer}</p>
    <p class="clock-time" data-timer-time role="timer" aria-live="off">0:00</p>
    <p class="clock-next" data-timer-next></p>
    <div class="clock-btns">
      <button type="button" data-timer-minus>−15</button>
      <button type="button" data-timer-plus>+15</button>
      <button type="button" data-timer-skip>{s.skip}</button>
    </div>
  </div>

  <div class="verdict" data-pr hidden role="dialog" aria-modal="true" aria-labelledby="pr-title">
    <div class="verdict-lights" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="verdict-title" id="pr-title">{s.prTitle}</p>
    <p class="verdict-sub">{s.prSub}</p>
    <p class="verdict-name" data-pr-name></p>
    <p class="verdict-value" data-pr-value></p>
    <p class="verdict-old"><span>{s.prWas}</span> <s data-pr-old></s></p>
  </div>

  <div class="summary" data-summary hidden role="dialog" aria-modal="true" aria-labelledby="sum-title">
    <div class="summary-card">
      <p class="summary-title" id="sum-title">{s.summaryTitle}</p>
      <dl class="summary-stats">
        <div><dt>{s.sumSets}</dt><dd data-sum-sets></dd></div>
        <div><dt>{s.sumTonnage}</dt><dd data-sum-tonnage></dd></div>
        <div><dt>{s.sumTime}</dt><dd data-sum-time></dd></div>
      </dl>
      <p class="summary-h">{s.sumPrs}</p>
      <ul class="summary-prs" data-sum-prs></ul>
      <button type="button" class="board-done" data-log-it data-sum-log>{s.logIt}</button>
      <button type="button" class="wk-btn wk-btn-quiet" data-sum-close>{s.close}</button>
    </div>
  </div>

  <label id="wk-haptic" class="sr" aria-hidden="true"><input type="checkbox" tabindex="-1" {...{ switch: "" }} /></label>
</section>

<script>
  import { mountWorkout } from '../scripts/workout';
  document.querySelectorAll<HTMLElement>('[data-workout]').forEach(mountWorkout);
</script>
