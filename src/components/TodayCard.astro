---
// Attempt-card pointer from the home page into today's workout (filled in on the client).
import { plan } from '../lib/plan';
import { href, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang].today;
const phases = plan.phases.map((p) => ({ weeks: p.weeks, label: p.label[lang] }));
---
<a class="today" href={href(lang, 'program/')} data-today data-start={plan.start} data-weeks={plan.weeks} data-phases={JSON.stringify(phases)}>
  <span class="today-label">{s.label}</span>
  <span class="today-main" data-today-main>{s.open}</span>
  <span class="today-sub" data-today-sub></span>
</a>

<script>
  import { t } from '../lib/i18n';
  import { weekFor } from '../lib/plan';
  for (const el of document.querySelectorAll<HTMLAnchorElement>('[data-today]')) {
    const lang = (document.documentElement.lang === 'ja' ? 'ja' : 'en') as 'en' | 'ja';
    const s = t[lang].today;
    const weeks = Number(el.dataset.weeks);
    const phases = JSON.parse(el.dataset.phases!) as { weeks: number[]; label: string }[];
    const week = weekFor(new Date());
    let last: string | null = null;
    try {
      last = JSON.parse(localStorage.getItem('muscle:v2:lastDay') ?? 'null');
    } catch {}
    const next = last === 'A' ? 'B' : 'A';
    const main = el.querySelector('[data-today-main]')!;
    const sub = el.querySelector('[data-today-sub]')!;
    if (week === 0) main.textContent = `${s.before} ${el.dataset.start}`;
    else if (week > weeks) main.textContent = s.after;
    else {
      main.textContent = `${lang === 'ja' ? `${next}日` : `Day ${next}`}`;
      sub.textContent = `${s.week(week, weeks)} · ${phases.find((p) => p.weeks.includes(week))?.label ?? ''}`;
    }
  }
</script>
