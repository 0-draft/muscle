---
// Side-on bumper plate glyph. Height encodes plate weight (evidence strength).
import type { Grade } from '../lib/grades';
interface Props { grade: Grade; size?: number }
const { grade, size = 1 } = Astro.props;
const h = { A: 44, B: 38, C: 32, D: 26 }[grade] * size;
const w = 9 * size;
---
<svg class="plate" data-grade={grade} width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true" focusable="false">
  <rect x="0" y="0" width={w} height={h} rx={2 * size} />
</svg>
