---
// Side-on bumper plate glyph. Height encodes plate weight (evidence strength); the letter is
// carried by the surrounding text, so colour is never the only signal.
import { PLATE_H, type Grade } from '../lib/grades';
interface Props { grade: Grade; size?: number }
const { grade, size = 1 } = Astro.props;
const h = 44 * PLATE_H[grade] * size;
const w = 9 * size;
---
<svg class="plate" data-grade={grade} width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width={w - 1} height={h - 1} rx={2 * size} />
</svg>
