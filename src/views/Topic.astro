---
import Base from '../layouts/Base.astro';
import Tally from '../components/Tally.astro';
import Lights from '../components/Lights.astro';
import { GRADES } from '../lib/grades';
import { href, t, type Lang } from '../lib/i18n';
import { isoDate, knowledgeFor } from '../lib/content';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t[lang];
const row = (await knowledgeFor(lang)).find((r) => r.slug === slug)!;
const { entry, counts, claims } = row;
const { Content, headings } = row.rendered;
const toc = headings.filter((h) => h.depth === 2);
const date = isoDate(entry.data.last_reviewed);
const label = Object.fromEntries(GRADES.map((g) => [g.id, g.label[lang]]));
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary}>
  <article class="doc">
    <header class="doc-head">
      <a class="back" href={href(lang)}>{s.back}</a>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <p class="doc-meta"><Tally counts={counts} label={s.breakdown} /><span>{s.lastReviewed} <time datetime={date}>{date}</time></span><a href={href(lang, 'grades/')}>{s.nav.grades}</a></p>
    </header>
    {claims.length > 0 && (
      <details class="sof" open>
        <summary>{s.claimsTitle}<span class="sof-n">{claims.length}</span></summary>
        <ol>
          {claims.map((c) => (
            <li data-grade={c.grade}>
              <a href={`#${c.id}`}>
                <Lights grade={c.grade} size="md" />
                <span class="sof-grade"><span class="sof-letter">{c.grade}</span>{label[c.grade]}</span>
                <span class="sof-text">{c.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    )}
    <div class="doc-body">
      <div class="prose"><Content /></div>
      {toc.length > 2 && (
        <nav class="toc" aria-label={s.toc}>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
  </article>
</Base>
