---
import Base from '../layouts/Base.astro';
import Lights from '../components/Lights.astro';
import VerdictWall from '../components/VerdictWall.astro';
import Tally from '../components/Tally.astro';
import TodayCard from '../components/TodayCard.astro';
import { GRADES, addCounts, emptyCounts } from '../lib/grades';
import { href, t, type Lang } from '../lib/i18n';
import { isoDate, knowledgeFor, paperCount } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const AREAS = ['training', 'nutrition', 'recovery', 'adherence'] as const;
const rows = await knowledgeFor(lang);
const total = rows.reduce((acc, r) => addCounts(acc, r.counts), emptyCounts());
const claims = rows.flatMap((r) => r.claims.map((c) => ({ ...c, href: href(lang, `k/${r.slug}/#${c.id}`), topic: r.entry.data.title })));
const papers = await paperCount(lang);
---
<Base lang={lang}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-lights" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="hero-kicker">{s.heroKicker}</p>
      <h1>{s.heroTitle[0]}<br />{s.heroTitle[1]}</h1>
      <p class="lede">{s.heroLede}</p>
      <dl class="hero-tally">
        {GRADES.map((g) => (
          <div>
            <dt><Lights grade={g.id} size="md" label={s.lightsLabel(g.white)} /><span>{g.label[lang]}</span></dt>
            <dd>{total[g.id]}</dd>
          </div>
        ))}
      </dl>
      <TodayCard lang={lang} />
      <VerdictWall claims={claims} papers={papers} lang={lang} />
    </div>
  </section>

  {AREAS.map((area) => {
    const list = rows.filter((r) => r.entry.data.area === area);
    if (list.length === 0) return null;
    return (
      <section class="area" aria-labelledby={`area-${area}`}>
        <h2 id={`area-${area}`}>{s.areas[area]}</h2>
        <ul class="topics">
          {list.map(({ entry, counts, slug }) => (
            <li>
              <a href={href(lang, `k/${slug}/`)}>
                <span class="topic-title">{entry.data.title}</span>
                <span class="topic-summary">{entry.data.summary}</span>
                <span class="topic-meta">
                  <Tally counts={counts} label={s.breakdown} />
                  <time datetime={isoDate(entry.data.last_reviewed)}>{isoDate(entry.data.last_reviewed)} {s.reviewed}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</Base>
