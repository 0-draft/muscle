---
import '../styles/global.css';
import { asset } from '../lib/grades';
import { href, switchPath, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; title?: string; description?: string }
const { lang, title, description } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'en' ? 'ja' : 'en';
const fullTitle = title ? `${title} | ${s.siteName}` : s.siteName;
const path = Astro.url.pathname;
const home = href(lang);
const nav = [
  { href: home, label: s.nav.knowledge, match: path === home || path.startsWith(href(lang, 'k/')) },
  { href: href(lang, 'program/'), label: s.nav.program, match: path.startsWith(href(lang, 'program/')) },
  { href: href(lang, 'grades/'), label: s.nav.grades, match: path.startsWith(href(lang, 'grades/')) },
];
const abs = (p: string) => new URL(p, Astro.site).href;
const alt = switchPath(path, other);
const enPath = lang === 'en' ? path : alt;
const jaPath = lang === 'ja' ? path : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#16181d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.description} />
    <link rel="alternate" hreflang="en" href={abs(enPath)} />
    <link rel="alternate" hreflang="ja" href={abs(jaPath)} />
    <link rel="alternate" hreflang="x-default" href={abs(enPath)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&family=BIZ+UDPGothic:wght@400;700&family=Dela+Gothic+One&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-head">
      <a class="brand" href={home}>
        <svg width="30" height="20" viewBox="0 0 30 20" aria-hidden="true"><rect x="0" y="9" width="30" height="2" rx="1" fill="currentColor"/><rect x="4" y="1" width="5" height="18" rx="1.5" class="brand-plate"/><rect x="21" y="1" width="5" height="18" rx="1.5" class="brand-plate"/></svg>
        <span>{s.siteName}</span>
      </a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={n.match ? 'page' : undefined}>{n.label}</a>)}
        <a class="lang" href={alt} hreflang={other} lang={other} data-lang-switch={other}>{s.langName}</a>
      </nav>
    </header>
    <p class="lang-hint" data-lang-hint hidden><a href={alt} hreflang={other} lang={other} data-lang-switch={other}>{t[other].langSuggest}</a><button type="button" aria-label="Close" data-lang-dismiss>×</button></p>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <p>{s.footer}</p>
      <p><a href="https://github.com/0-draft/muscle">{s.source}</a></p>
    </footer>
    <script>
      // Remember an explicit language choice; only suggest (never redirect) based on the browser language.
      const here = document.documentElement.lang;
      const store = (k: string, v?: string) => {
        try {
          if (v === undefined) return localStorage.getItem(k);
          localStorage.setItem(k, v);
        } catch {}
        return null;
      };
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
        a.addEventListener('click', () => store('muscle:lang', a.dataset.langSwitch)),
      );
      const pref = store('muscle:lang');
      const browser = navigator.language?.startsWith('ja') ? 'ja' : 'en';
      const hint = document.querySelector<HTMLElement>('[data-lang-hint]');
      if (hint && !pref && browser !== here && store('muscle:langHintClosed') !== '1') hint.hidden = false;
      document.querySelector('[data-lang-dismiss]')?.addEventListener('click', () => {
        store('muscle:langHintClosed', '1');
        if (hint) hint.hidden = true;
      });
      if (import.meta.env.PROD && 'serviceWorker' in navigator)
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`).catch(() => {});
    </script>
  </body>
</html>
